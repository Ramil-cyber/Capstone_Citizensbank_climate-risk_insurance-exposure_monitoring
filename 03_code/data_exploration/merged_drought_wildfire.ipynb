    "drought = drought.drop(drought[drought[\"FIPS\"] == \"00000\"].index)\n",
    "drought = (\n",
    "    drought.groupby([\"FIPS\", \"Year\"])\n",
    "    .agg(\n",
    "        {\n",
    "            \"County\": \"first\",\n",
    "            \"State\": \"first\",\n",
    "            \"State_abbr\": \"first\",\n",
    "            \"Annual_Mean_Index\": \"mean\",\n",
    "        }\n",
    "    )\n",
    "    .reset_index()\n",
    ")\n",
    "drought.head()"
   ]
